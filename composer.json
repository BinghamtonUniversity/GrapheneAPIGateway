{
    "name": "laravel/lumen",
    "description": "Graphene API Gateway.",
    "keywords": ["framework", "laravel", "lumen"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "vlucas/phpdotenv": "^5.7",
        "laravel/lumen-framework": "^10.0",
        "illuminate/mail": "^10.22",
        "symfony/var-dumper": "^6.4",
        "google/apiclient": "^2.20",
        "mustache/mustache": "^3.2",
        "directorytree/ldaprecord": "^4.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "yajra/laravel-oci8": "Adds support for Oracle.  Version matches lumen-framework.",
        "google/apiclient": "Adds support for Google APIs"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "platform": {"php": "8.3"},
        "policy": {
            "advisories": {
                "ignore-id": ["PKSA-zwc5-qtrz-zm1n"]
            }
        }
    }
}
