{
    "name": "laravel/laravel",
    "description": "Graphene API Gateway.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "vlucas/phpdotenv": "^5.7",
        "google/apiclient": "^2.20",
        "mustache/mustache": "^3.2",
        "directorytree/ldaprecord": "^4.1"
    },
    "suggest": {
        "yajra/laravel-oci8":"Adds support for Oracle Database"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": false,
        "platform": {
            "php": "8.5.0"
        }
    }
}